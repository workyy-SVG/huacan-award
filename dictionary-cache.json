{
  "entries": {
    "門": {
      "title": "門",
      "heteronyms": [
        {
          "bopomofo": "ㄇㄣˊ",
          "definitions": [
            {
              "example": [
                "如：「房門」、「車門」、「拱門」、「城門」、「鐵捲門」。"
              ],
              "def": "建築物或車、船等可以開關的出入口，也指設於出入口能關閉的裝置。",
              "type": "名"
            },
            {
              "example": [
                "如：「閘門」、「活門」、「水門」。"
              ],
              "def": "形狀或作用像門的物體。",
              "type": "名"
            },
            {
              "example": [
                "如：「肛門」。"
              ],
              "def": "人體身上的孔竅。",
              "quote": [
                "《浮生六記．卷六．養生記逍》：「謹守四門，眼耳鼻口。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「寒門」、「豪門」。"
              ],
              "def": "家族、門第。",
              "quote": [
                "《北史．卷二九．劉昶傳》：「唯能是寄，不必拘門。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「佛門」、「獨門絕活」。"
              ],
              "def": "學派、宗派。",
              "quote": [
                "漢．王充《論衡．問孔》：「論者皆云：『孔門之徒，七十子之才，勝今之儒。』」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「竅門」、「不二法門」。"
              ],
              "def": "關鍵、要點、方法。",
              "quote": [
                "《老子》第一章：「玄之又玄，眾妙之門。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「分門別類」、「五花八門」。"
              ],
              "def": "類別。",
              "type": "名"
            },
            {
              "example": [
                "如：「脊椎動物門」、「原生動物門」。"
              ],
              "def": "生物學上分類系統所用的等級之一。",
              "type": "名"
            },
            {
              "def": "量詞：(1)計算科學、技藝門類的單位。如：「一門功課」、「兩門技術」。(2)計算大炮的單位。如：「三門大炮」。(3)計算親戚家數的單位。如：「他有兩門親家。」",
              "type": "名"
            },
            {
              "def": "姓。如明代有門克新。",
              "type": "名"
            },
            {
              "def": "二一四部首之一。",
              "type": "名"
            }
          ],
          "pinyin": "mén",
          "bopomofo2": "mén"
        }
      ],
      "radical": "門",
      "stroke_count": 8,
      "non_radical_stroke_count": 0
    },
    "年": {
      "title": "年",
      "heteronyms": [
        {
          "bopomofo": "ㄋㄧㄢˊ",
          "definitions": [
            {
              "def": "相當於地球環繞太陽一周所需的時間。參見「太陽年」條。",
              "type": "名"
            },
            {
              "example": [
                "如：「豐年」、「歉年」、「年景」。"
              ],
              "def": "收成、年成。",
              "quote": [
                "《新唐書．卷九九．列傳．戴冑》：「七月以來，霖潦未止，濱河南北，田正洿下，年之有亡未可知。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「過年」。"
              ],
              "def": "年節。",
              "quote": [
                "宋．陳師道〈早春〉詩：「度臘不成雪，迎年遽得春。」",
                "《儒林外史》第一一回：「新年正月，公子回家拜祖父、母親的年回來。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「盛年」、「延年益壽」、「年輕力壯」。"
              ],
              "def": "歲數、年齡。",
              "quote": [
                "唐．杜甫〈暮歸〉詩：「年過半百不稱意，明日看雲還杖藜。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「八十年代」、「康熙年間」。"
              ],
              "def": "時代、時期。",
              "quote": [
                "唐．杜甫〈寄題江外草堂〉詩：「經營上元始，斷手寶應年。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「童年」、「青少年」、「壯年」、「老年」。"
              ],
              "def": "人生中的某時期。",
              "type": "名"
            },
            {
              "example": [
                "如：「這件事要花四年才能完成。」"
              ],
              "def": "量詞。計算時間的單位。一年有十二個月。",
              "type": "名"
            },
            {
              "def": "姓。如清代有年羹堯。",
              "type": "名"
            },
            {
              "example": [
                "如：「年鑑」、「年表」、「年刊」、「年產量」。"
              ],
              "def": "每年。",
              "type": "形"
            },
            {
              "example": [
                "如：「年糕」、「年畫」、「辦年貨」。"
              ],
              "def": "年節的。",
              "type": "形"
            }
          ],
          "pinyin": "nián",
          "bopomofo2": "nián"
        }
      ],
      "radical": "干",
      "stroke_count": 6,
      "non_radical_stroke_count": 3
    },
    "圓": {
      "title": "圓",
      "heteronyms": [
        {
          "bopomofo": "ㄩㄢˊ",
          "definitions": [
            {
              "example": [
                "如：「圓球」、「圓桌」。"
              ],
              "def": "不露稜角的、環形的。相對於「方」。",
              "type": "形"
            },
            {
              "def": "完整、周全、豐滿。",
              "quote": [
                "《呂氏春秋．士容論．審時》：「疏穖而穗大，其粟圓而薄糠。」",
                "南朝梁．劉勰《文心雕龍．明詩》：「自商暨周，雅頌圓備。」"
              ],
              "type": "形"
            },
            {
              "def": "婉轉、滑潤。",
              "quote": [
                "唐．元稹〈善歌如貫珠賦〉：「吟斷章而離離若間，引妙囀而一一皆圓。」",
                "明．湯顯祖《牡丹亭》第一〇齣：「生生燕語明如翦，嚦嚦鶯歌溜的圓。」"
              ],
              "type": "形"
            },
            {
              "def": "從中心到周圍每一點的距離都相等的形體稱為「圓」。",
              "quote": [
                "《墨子．法儀》：「百工為方以矩，為圓以規。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「金圓」、「銀圓」、「日圓」。"
              ],
              "def": "貨幣的名稱。",
              "type": "名"
            },
            {
              "example": [
                "如：「拾圓」、「伍圓」。"
              ],
              "def": "量詞。計算錢幣的單位。一圓等於十角。",
              "type": "名"
            },
            {
              "example": [
                "如：「圓謊」、「自圓其說」。"
              ],
              "def": "完成、使完整。",
              "quote": [
                "《紅樓夢》第六八回：「暫且住著，等滿了服再圓房。」"
              ],
              "type": "動"
            }
          ],
          "pinyin": "yuán",
          "bopomofo2": "üán"
        }
      ],
      "radical": "囗",
      "stroke_count": 13,
      "non_radical_stroke_count": 10
    },
    "茶": {
      "title": "茶",
      "heteronyms": [
        {
          "bopomofo": "ㄔㄚˊ",
          "definitions": [
            {
              "def": "植物名。山茶科茶屬，「茶樹」之古稱。參見「茶樹」條。",
              "type": "名"
            },
            {
              "example": [
                "如：「飲茶」、「品茶」。"
              ],
              "def": "用茶葉沏成或煮成的飲料。",
              "quote": [
                "《京本通俗小說．馮玉梅團圓》：「婦人口渴，徐信引到一個茶肆中喫茶。」"
              ],
              "type": "名"
            },
            {
              "example": [
                "如：「苦茶」、「冬瓜茶」、「杏仁茶」。"
              ],
              "def": "泛稱某種飲料。",
              "type": "名"
            }
          ],
          "pinyin": "chá",
          "bopomofo2": "chá"
        }
      ],
      "radical": "艸",
      "stroke_count": 10,
      "non_radical_stroke_count": 6
    },
    "燈": {
      "title": "燈",
      "heteronyms": [
        {
          "bopomofo": "ㄉㄥ",
          "definitions": [
            {
              "example": [
                "如：「電燈」、「日光燈」、「紅綠燈」。"
              ],
              "def": "照明或作為他用的發光器具。",
              "type": "名"
            },
            {
              "example": [
                "如：「酒精燈」、「本生燈」。"
              ],
              "def": "燃燒液體或氣體，用來對他物加熱的器具。",
              "type": "名"
            },
            {
              "def": "佛法導向光明坦途，趨避邪惡黑暗，故稱佛法為「燈」。",
              "quote": [
                "唐．杜甫〈望牛頭寺〉詩：「傳燈無白日，布地有黃金。」"
              ],
              "type": "名"
            }
          ],
          "pinyin": "dēng",
          "bopomofo2": "deng"
        }
      ],
      "radical": "火",
      "stroke_count": 16,
      "non_radical_stroke_count": 12
    }
  },
